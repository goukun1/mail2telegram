{
    "name": "mail2telegram",
    "type": "module",
    "version": "2.0.0",
    "description": "Forward email to telegram with a Telegram Mini App inbox",
    "author": "TBXark",
    "license": "MIT",
    "homepage": "https://github.com/TBXark/mail2telegram",
    "repository": {
        "type": "git",
        "url": "https://github.com/TBXark/mail2telegram"
    },
    "private": true,
    "packageManager": "pnpm@11.11.0",
    "scripts": {
        "dev": "concurrently -k -n web,worker -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:worker\"",
        "dev:web": "pnpm --filter @mail2telegram/web dev",
        "dev:worker": "wrangler dev",
        "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/server/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
        "build": "pnpm typecheck && pnpm --filter @mail2telegram/web build",
        "build:web": "pnpm --filter @mail2telegram/web build",
        "deploy:config": "node scripts/build-config.mjs",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "node scripts/build-config.mjs && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc",
        "deploy": "node scripts/build-config.mjs && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc && pnpm --filter @mail2telegram/web build && wrangler deploy --config wrangler.deploy.jsonc",
        "screenshots": "pnpm --filter @mail2telegram/web screenshots",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "pnpm test:unit && pnpm test:pool",
        "test:unit": "pnpm --filter @mail2telegram/server test:unit",
        "test:pool": "pnpm --filter @mail2telegram/server test:pool",
        "wrangler": "wrangler"
    },
    "devDependencies": {
        "@types/node": "^26.5.1",
        "concurrently": "^10.0.5",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "typescript": "^6.0.3",
        "wrangler": "^4.131.1"
    }
}
