{
    "name": "mail2telegram",
    "type": "module",
    "version": "2.0.0",
    "description": "Forward email to telegram with a Telegram Mini App inbox",
    "author": "TBXark",
    "license": "MIT",
    "homepage": "https://github.com/TBXark/mail2telegram",
    "repository": {
        "type": "git",
        "url": "https://github.com/TBXark/mail2telegram"
    },
    "main": "src/index.ts",
    "scripts": {
        "dev": "concurrently -k -n web,worker -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:worker\"",
        "dev:web": "vite",
        "dev:worker": "wrangler dev",
        "build": "tsc --noEmit && vite build",
        "build:web": "vite build",
        "deploy:config": "node scripts/build-config.mjs",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "node scripts/build-config.mjs && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc",
        "deploy": "node scripts/build-config.mjs && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc && vite build && wrangler deploy --config wrangler.deploy.jsonc",
        "screenshots": "node scripts/screenshots/generate-screenshots.mjs",
        "lint": "eslint --fix src web scripts test vitest.config.mts",
        "test": "pnpm test:unit && pnpm test:pool",
        "test:unit": "tsx src/test.ts",
        "test:pool": "vitest run",
        "wrangler": "wrangler"
    },
    "dependencies": {
        "@tma.js/init-data-node": "^2.0.8",
        "@tma.js/sdk-react": "^3.0.23",
        "dompurify": "^3.4.15",
        "html-to-text": "^10.0.1",
        "itty-router": "^5.0.24",
        "konsta": "^5.4.0",
        "postal-mime": "^3.0.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.3"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.5.1",
        "@cloudflare/vitest-pool-workers": "^0.22.0",
        "@cloudflare/workers-types": "^5.20260911.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/html-to-text": "^9.0.4",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-plugin-format": "^2.0.1",
        "puppeteer": "^25.10.0",
        "tailwindcss": "^4.3.3",
        "telegram-bot-api-types": "^10.2.0",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vitest": "^4.1.11",
        "wrangler": "^4.131.1"
    }
}
