{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": [
            "node"
        ],
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "paths": {
            "@/*": [
                "./web/*"
            ]
        }
    },
    "include": [
        "src",
        "web",
        "scripts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build"
    ]
}
