{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "mail2telegram",
    "main": "src/index.ts",
    "compatibility_date": "2025-09-15",
    "compatibility_flags": [
        "nodejs_compat_v2"
    ],
    // The frontend SPA built by Vite into ./dist/client.
    // API and webhook routes are handled by the Worker first.
    "assets": {
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*",
            "/init",
            "/email/*",
            "/telegram/*"
        ]
    },
    // Real ids are injected by scripts/build-config.mjs via DEPLOY_* build variables.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "mail2telegram",
            "database_id": ""
        }
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": ""
        }
    ],
    "ai": {
        "binding": "AI"
    },
    "vars": {
        "DOMAIN": "mail2telegram.YOUR_NAME.workers.dev",
        "TELEGRAM_ID": "YOUR_TELEGRAM_ID",
        "TELEGRAM_TOKEN": "YOUR_TELEGRAM_TOKEN",
        "FORWARD_LIST": "YOUR_BACKUP_EMAIL",
        // "WORKERS_AI_MODEL": "@cf/meta/llama-3-8b-instruct", // Remove the comment to enable Workers AI
        // "OPENAI_API_KEY": "sk-", // Remove the comment to enable OpenAI
        // "OPENAI_COMPLETIONS_API": "https://openrouter.ai/api/v1/chat/completions",
        // "OPENAI_CHAT_MODEL": "openai/gpt-4o-mini",
        // "SUMMARY_TARGET_LANG": "chinese",
        // "WHITE_LIST": "[\"@example.com$\"]",
        // "BLOCK_LIST": "[\"spam@example.com\"]",
        // "MAIL_TTL": "86400",
        "GUARDIAN_MODE": "false",
        // "MAX_EMAIL_SIZE": "524288",
        "MAX_EMAIL_SIZE_POLICY": "truncate",
        "DEBUG": "false"
    }
}
