{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "mail2telegram",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-11",
    // Daily cron that deletes mail older than the auto cleanup retention
    // (Settings → Mail Handling → Auto Cleanup, 0 disables it).
    "triggers": {
        "crons": ["0 3 * * *"]
    },
    // The frontend SPA built by Vite into ./dist/client.
    // API and webhook routes are handled by the Worker first.
    "assets": {
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*",
            "/init",
            "/email/*",
            "/telegram/*"
        ]
    },
    // Real ids are injected by scripts/build-config.mjs via DEPLOY_* build variables.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "mail2telegram",
            "database_id": ""
        }
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": ""
        }
    ],
    "ai": {
        "binding": "AI"
    },
    // Only the bot identity is required here. Everything else (allow/block
    // lists, forwarding, summaries, mail limits) is configured in the Mini App
    // under Settings. Legacy variables are still honored and can be migrated
    // via Settings → Bot & Webhook → Import from Environment.
    "vars": {
        "DOMAIN": "mail2telegram.YOUR_NAME.workers.dev",
        "TELEGRAM_ID": "YOUR_TELEGRAM_ID",
        "TELEGRAM_TOKEN": "YOUR_TELEGRAM_TOKEN",
        "DEBUG": "false"
        // Optional secret, add via the dashboard instead:
        // "RESEND_API_KEY": "re_..."  // enables replying to emails
        // The OpenAI-compatible API key, endpoint and model are configured in
        // the Mini App under Settings → Summaries.
    }
}
